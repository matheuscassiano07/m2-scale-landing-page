# Copie para .env e preencha. Defina os mesmos valores em
# Vercel · Settings · Environment Variables (Production e Preview).

# Evolution API (obrigatórios)
EVOLUTION_API_URL=https://evo.seudominio.com
EVOLUTION_API_KEY=cole-aqui-a-api-key-da-evolution
EVOLUTION_INSTANCE=zira-admin

# Token usado para proteger /api/wa/qrcode e /api/wa/status.
# Use um valor aleatório forte (32+ caracteres). O mesmo valor precisa
# estar em assets/admin-config.js (window.ZIRA_ADMIN_API_TOKEN).
ZIRA_ADMIN_API_TOKEN=troque-por-um-token-aleatorio-de-32-chars

# Número que receberá a notificação de novo lead.
# Se vazio, o servidor usa o número conectado pelo QR como destino.
WA_NOTIFY_NUMBER=
WA_DEFAULT_DDI=55
