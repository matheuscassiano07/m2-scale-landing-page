# Copie para .env (local) e replique em Vercel · Project · Settings · Environment Variables.
# Marque Production e Preview (e Development se usar `vercel dev`).
#
# ═══════════════════════════════════════════════════════════════════════════
# CHECKLIST VERCEL — nome da variável = o que colocar
# ═══════════════════════════════════════════════════════════════════════════
#
# ADMIN_USERNAME          → utilizador do login /admin (ex.: admin ou o teu user)
# ADMIN_PASSWORD          → palavra-passe forte (única por projeto)
# SESSION_SECRET          → string aleatória 32+ caracteres (assinatura do cookie)
#
# EVOLUTION_API_URL       → URL pública HTTPS da Evolution (ex.: https://api.teudominio.com)
#                           NUNCA http://127.0.0.1 na Vercel — o servidor não alcança a tua máquina.
# EVOLUTION_API_KEY       → API key global da instalação Evolution
# EVOLUTION_INSTANCE      → nome da instância (ex.: zira-admin)
#
# EVOLUTION_FETCH_TIMEOUT_MS → opcional; omissão no código = 10000 (10s). Se a Evolution for lenta: 25000
# EVOLUTION_FETCH_RETRIES    → opcional; omissão = 2 (só retenta falhas rápidas de rede)
# EVOLUTION_TLS_INSECURE     → só se certificado self-signed: valor exato 1
# EVOLUTION_IPV4_FIRST       → só se “fetch failed” / DNS IPv6: valor exato 1
#
# SUPABASE_URL            → URL do projeto Supabase
# SUPABASE_SERVICE_ROLE_KEY → service role key (nunca no cliente)
#
# WA_NOTIFY_NUMBER        → WhatsApp E.164 sem + (ex.: 5511999998888)
# WA_DEFAULT_DDI          → DDI por omissão (ex.: 55)
#
# ZIRA_DEBUG_WA           → opcional; 0 ou omitir em produção; 1 só para depurar QR no painel
# ZIRA_ADMIN_API_TOKEN    → opcional; token longo se algum fluxo chamar APIs com header x-zira-admin
#
# ═══════════════════════════════════════════════════════════════════════════

# ──────────────── Login do painel /admin ────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Chave aleatória para assinar o cookie httpOnly de sessão (use 32+ chars)
SESSION_SECRET=troque-por-uma-string-aleatoria-forte-com-32-plus-chars

# ──────────────── Evolution API (WhatsApp) ────────────────
EVOLUTION_API_URL=https://evo.seudominio.com
EVOLUTION_API_KEY=cole-aqui-a-api-key-da-evolution
EVOLUTION_INSTANCE=zira-admin

# Valores por omissão alinhados com api/_lib/evolution.js (podes omitir na Vercel = mesmo comportamento)
EVOLUTION_FETCH_TIMEOUT_MS=10000
EVOLUTION_FETCH_RETRIES=2

# Só definir na Vercel se precisares (valor tem de ser exatamente 1):
# EVOLUTION_TLS_INSECURE=1
# EVOLUTION_IPV4_FIRST=1

# Se o painel mostrar "fetch failed" / upstream ao gerar QR:
# - URL tem de ser alcançável a partir do servidor (ex.: Vercel não alcança localhost na sua máquina).
# - Certificado self-signed / CA interna: EVOLUTION_TLS_INSECURE=1 (só em origem confiável).
# - Alguns hosts falham em IPv6: EVOLUTION_IPV4_FIRST=1
# - Timeout maior (ms, máx. 55000): EVOLUTION_FETCH_TIMEOUT_MS=25000

# Resposta de /api/wa/qrcode inclui o objeto qrDebug (evolutionCount, tentativas connect, etc.) quando
# ZIRA_DEBUG_WA=1, ou em vercel dev (VERCEL_ENV=development), ou NODE_ENV=development.
# Em produção na Vercel usa 0 ou remove a variável.
ZIRA_DEBUG_WA=0

# Opcional: integrações que enviem o header HTTP x-zira-admin (mesmo valor em ambos os lados)
# ZIRA_ADMIN_API_TOKEN=troque-por-token-longo-aleatorio

# ──────────────── Banco de leads (produção) ────────────────# Recomendado: Supabase (Postgres) com service role key.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui


# Fallback local (apenas dev/ambiente com disco persistente).
# Em serverless puro, /tmp é volátil e pode perder dados.
# LEADS_FILE_PATH=/var/data/m2scale-leads-v1.json

# Número que receberá os leads no WhatsApp (altere quando quiser)
WA_NOTIFY_NUMBER=5512991743047
WA_DEFAULT_DDI=55
